{
  "tz": "America/Chicago",
  "description": "A block with no Agent: lines keeps the old dispatch shape. Nothing is refused for want of a type.",
  "prompt": "Start the security audit.",
  "graders": [
    {
      "name": "reads the dispatch skill before the first launch, worktree, models call or tracker write",
      "rule": "In an interactive workspace with no `Agent:` lines in the block: a background subagent (the `Agent` tool with `run_in_background: true`), and the subagent type.",
      "type": "tool_used",
      "tool": "Read",
      "input_match": "\"file_path\": \"[^\"\\n]*skills/dispatch/SKILL\\.md\"",
      "min": 1,
      "before": "\\A(?=[\\s\\S]*\"(?:old_string|content)\":)[\\s\\S]*\"file_path\": \"(?:[^\"\\n]*[/\\\\])?daily[/\\\\][^\"\\n/\\\\]*-tracker\\.md\"|\"command\": \"(?:\\\\.|[^\"\\\\])*(?:\\bchief[-_]of[-_]stuff(?:\\.py)?\\s+(?:worker|worktree|models)\\b|(?:scripts/)?(?:spawn_session|make_worktree)\\.py\\b)"
    },
    {
      "name": "no worktree cut before a yes",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:make_worktree\\.py|chief[-_]of[-_]stuff(?:\\.py)?\\s+worktree)[^\"]*--branch",
      "max": 0
    },
    {
      "name": "no session started before a yes",
      "type": "spawn_calls",
      "max": 0
    },
    {
      "name": "still proposes a subagent",
      "type": "regex",
      "pattern": "(?s)```(?:(?!```).)*\\bTask:(?:(?!```).)*\\bReport:(?:(?!```).)*```",
      "match": "contains"
    },
    {
      "name": "proposes the subagent channel, as before",
      "type": "regex",
      "pattern": "(?is)^(?=.*\\bbackground\\b)(?=.*(?:general-purpose|subagent type))",
      "match": "contains"
    },
    {
      "name": "nothing launched before a yes",
      "type": "tool_used",
      "tool": "Agent|Task",
      "max": 0
    }
  ],
  "max_turns": 12,
  "timeout_seconds": 400
}
