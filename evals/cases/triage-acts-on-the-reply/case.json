{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "Robin's triage reply is carried out without a second yes: fix goes to the implementer in plan mode, file is filed and the architecture finding goes to frank-lloyd-aight, discard is recorded. The fix report goes to the reviewer as a verify pass with the workspace mailbox, and a clean verify stops at the merge gate.",
  "turns": [
    {
      "prompt": "R1 fix, R2 file, R3 discard",
      "graders": [
        {
          "name": "reads the review-pipeline skill before the first tracker Edit/Write",
          "rule": "Record the reply as a Decisions row quoting it.",
          "type": "tool_used",
          "tool": "Read",
          "input_match": "\"file_path\": \"[^\"\\n]*skills/review-pipeline/SKILL\\.md\"",
          "min": 1,
          "before": "\\A(?=[\\s\\S]*\"(?:old_string|content)\":)[\\s\\S]*\"file_path\": \"(?:[^\"\\n]*[/\\\\])?daily[/\\\\]{{today}}-tracker\\.md\""
        },
        {
          "name": "the reply is quoted in Decisions",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?i)R1 fix, R2 file, R3 discard"
        },
        {
          "name": "R1 goes to the implementer in plan mode",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "d4e5f6",
          "ok": true,
          "text_match": "(?s)(?=.*R1)(?=.*(?i:plan mode))",
          "min": 1
        },
        {
          "name": "R3 is not sent to be fixed",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "d4e5f6",
          "text_match": "(?i)\\b(?:fix|inline|remove|drop|delete)\\w*\\s+(?:the\\s+)?PathPolicy",
          "max": 0
        },
        {
          "name": "R2 is filed once",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "backlog\\.py[^\"]*--create",
          "min": 1,
          "max": 1
        },
        {
          "name": "the architecture finding goes to frank-lloyd-aight",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "f7a8b9",
          "ok": true,
          "text_match": "R2|(?i:config)",
          "min": 1
        },
        {
          "name": "no verify before the fix",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "a1b2c3",
          "max": 0
        },
        {
          "name": "the task is at fix",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "\\| build \\| fix \\|"
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    },
    {
      "prompt": "<cross-session-message from=\"uds:/tmp/cc-socks/6021.sock\" from-name=\"impl-uploads\" from-mode=\"prompting\">\nR1 fixed: resolve() before the prefix check, with a symlink test. Pushed to uploads; PR 12 head is now 7d1e0b4. Suite 42/42 (`pytest -q`).\n</cross-session-message>",
      "graders": [
        {
          "name": "the verify pass goes to the reviewer with the workspace mailbox",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "a1b2c3",
          "ok": true,
          "text_match": "(?s)(?=.*R1)(?=.*--mailbox-dir /\\S*/\\.chief-of-stuff/mailbox )",
          "min": 1
        },
        {
          "name": "no second yes is asked for",
          "type": "regex",
          "pattern": "(?i)\\b(shall I|should I|want me to|ok to|okay to)\\b[^.?\\n]*\\b(send|hand|start|verify|reviewer)",
          "match": "absent"
        },
        {
          "name": "the task is at verify",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "\\| build \\| verify \\|"
        },
        {
          "name": "nothing is filed again",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "backlog\\.py[^\"]*--create",
          "max": 0
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    },
    {
      "prompt": "<cross-session-message from=\"uds:/tmp/cc-socks/5120.sock\" from-name=\"reviewer\" from-mode=\"prompting\">\nReviewer pass: verify @ 7d1e0b4\nPR: https://github.com/o/app/pull/12\nTests: pass \u2014 42/42 \u2014 `pytest -q`\nAxes examined: Correctness, Test run\nResolved: R1 \u2014 src/a/upload.py:4, resolve() now precedes the prefix check; symlink test at tests/test_upload.py:31\nFindings: none\n</cross-session-message>",
      "graders": [
        {
          "name": "the task sits at the merge gate",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "\\| build \\| merge \\|"
        },
        {
          "name": "no merge is run",
          "type": "tool_used",
          "tool": "Bash",
          "input_match": "gh pr merge|glab mr merge",
          "max": 0
        },
        {
          "name": "the merge is left to Robin",
          "type": "regex",
          "pattern": "(?i)merge"
        },
        {
          "name": "the implementer is not sent more work",
          "type": "peer_calls",
          "tool": "send",
          "to_ref": "d4e5f6",
          "max": 0
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    }
  ],
  "max_turns": 20,
  "timeout_seconds": 600,
  "superseded_by": "autonomy-review-fixes"
}
