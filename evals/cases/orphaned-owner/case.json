{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "A running task's owner is gone. Record the orphan and recover the task through a one-shot worker in its existing tree, without asking. Preserve the departed session's last reported state and never message it. Preview the launch to avoid a real nested worker.",
  "prompt": "Where are we? For this isolated test, use --dry-run on any worker launch and do not start a real worker process.",
  "graders": [
    {
      "name": "lists sessions",
      "type": "peer_calls",
      "tool": "list_sessions",
      "min": 1
    },
    {
      "name": "task made ready for the recovery launcher",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Security audit \\|\\s*unassigned\\s*\\|\\s*open\\s*\\|"
    },
    {
      "name": "Log names the gone owner",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^- \\d{1,2}:\\d{2} .*4821-audit.*(gone|orphan|not (in )?the (session )?list|no longer)"
    },
    {
      "name": "the Sessions state cell never says gone",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?im)^\\|\\s*a1b2c3\\s*\\|[^|\\n]*\\|\\s*gone\\s*\\|",
      "match": "absent"
    },
    {
      "name": "the gone owner's row keeps what it last said",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*a1b2c3\\s*\\|\\s*4821-audit\\s*\\|\\s*\\|"
    },
    {
      "name": "reply names the worktree at risk",
      "type": "regex",
      "pattern": "audit-upload",
      "match": "contains"
    },
    {
      "name": "no message to the gone session",
      "type": "peer_calls",
      "tool": "send",
      "to_ref": "a1b2c3",
      "max": 0
    },
    {
      "name": "no dispatch proposal",
      "type": "regex",
      "pattern": "(?s)```[^`]*Tracker:",
      "match": "absent"
    },
    {
      "name": "other task untouched",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Draft release notes \\| Robin \\| running 09:10"
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    },
    {
      "name": "one-shot recovery previewed",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\"command\": \"(?=[^\\n]*--one-shot)(?=[^\\n]*--dry-run)(?=[^\\n]*--cwd\\s+[^\\n]*trees/audit-upload)[^\\n]*(?:chief-of-stuff\\s+worker|chief_of_stuff\\.py\\s+worker|spawn_session\\.py)",
      "min": 1
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 400,
  "repo": {
    "clone": "repo",
    "trees": "trees",
    "files": {
      "src/a/upload.py": "def upload():\n    return True\n"
    },
    "worktrees": [
      {
        "name": "audit-upload",
        "branch": "fix/upload-audit",
        "merged": false
      }
    ]
  }
}
