{
  "tz": "America/Chicago",
  "description": "Open the day with a Board line and a server provisioned by the launcher. The supervisor owns availability; the server renders from the tracker, without routine agent maintenance or hand-written HTML.",
  "prompt": "Good morning. The launcher has already provisioned the board supervisor.",
  "graders": [
    {
      "name": "queries both calendars for today",
      "type": "mock_calls",
      "calendar_ids": [
        "cal-work",
        "cal-program"
      ],
      "covers": "{{today}}"
    },
    {
      "name": "log carries over README item",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Write eval README"
    },
    {
      "name": "log carries over deploy review",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Review deploy config"
    },
    {
      "name": "log lists standup",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Standup"
    },
    {
      "name": "log lists class",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "Data modeling"
    },
    {
      "name": "goal empty or marked proposed",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "^## Goal[ \\t]*\\n\\s*(?:##|.*(?i:proposed|TBD))"
    },
    {
      "name": "tracker task: README",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|(?:[^|\\n]*\\|)?\\s*Write eval README\\s*\\|"
    },
    {
      "name": "tracker task: deploy review",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|(?:[^|\\n]*\\|)?\\s*Review deploy config\\s*\\|"
    },
    {
      "name": "carried rows keep their lane and stage: README",
      "rule": "becomes a row in today's tracker Tasks, same item, owner, and checklist reference, with today's date as `since`",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|[^\\n]*Write eval README[^\\n]*\\|\\s*build\\s*\\|\\s*implement\\s*\\|"
    },
    {
      "name": "carried rows keep their lane and stage: deploy review",
      "rule": "becomes a row in today's tracker Tasks, same item, owner, and checklist reference, with today's date as `since`",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|[^\\n]*Review deploy config[^\\n]*\\|\\s*build\\s*\\|\\s*review\\s*\\|"
    },
    {
      "name": "tracker has Decisions",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## Decisions"
    },
    {
      "name": "tracker has File ownership",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## File ownership"
    },
    {
      "name": "tracker has Log",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "^## Log"
    },
    {
      "name": "no other new files",
      "type": "no_new_files",
      "except": [
        "daily/{{today}}.md",
        "daily/{{today}}-tracker.md",
        "pages/{{today}}-board.html"
      ]
    },
    {
      "name": "yesterday's log untouched",
      "type": "file_unchanged",
      "path": "daily/{{yesterday}}.md"
    },
    {
      "name": "yesterday's tracker untouched",
      "type": "file_unchanged",
      "path": "daily/{{yesterday}}-tracker.md"
    },
    {
      "name": "ends with a question",
      "type": "regex",
      "pattern": "\\?\\s*\\Z"
    },
    {
      "name": "reads the real clock",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bdate\\b",
      "min": 1
    },
    {
      "name": "clock line to the deadline",
      "type": "clock_line",
      "gate": "{{today}} 23:59"
    },
    {
      "name": "supervisor owns server availability",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bpages(?:\\.py)?\\s[^\\\"]*(?:--ensure|\\bensure\\b|\\bsupervise\\b)",
      "max": 0,
      "rule": "The launcher provisions `chief-of-stuff pages ensure`; direct plugin launches run it once at Open the day or Resume."
    },
    {
      "name": "no render step: the server renders",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "render_board|decision_page|chief[-_]of[-_]stuff(?:\\.py)? (?:board|decision)\\b",
      "max": 0
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "board rendered with both carried tasks and the deadline",
      "type": "board_published",
      "tasks": [
        "Write eval README",
        "Review deploy config"
      ],
      "deadline": "{{today}}T23:59:00-05:00"
    },
    {
      "name": "board matches the final tracker",
      "type": "board_matches_tracker",
      "tracker": "daily/{{today}}-tracker.md",
      "html": "pages/{{today}}-board.html"
    }
  ],
  "max_turns": 24,
  "timeout_seconds": 300,
  "calendar": "calendar.json"
}
