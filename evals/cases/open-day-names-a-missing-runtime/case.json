{
  "tz": "America/Chicago",
  "description": "Opening the day runs health and reports missing Claude through the adapter (ledger D11, #635). The rotation names Claude and Codex, but only Codex is present in the fixture. Preflight checks Claude only; the reply must name Claude as missing.",
  "prompt": "Good morning.",
  "graders": [
    {
      "name": "health was run",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\"command\": \"(?:[^\"\\\\]|\\\\.)*?(?:chief[-_]of[-_]stuff(?:\\.py)?\\s+health\\b|probe_health\\.py)",
      "min": 1
    },
    {
      "name": "reply names claude as missing",
      "type": "regex",
      "pattern": "(?im)claude(?:(?!codex|cursor|agy|[.;]\\s)[^\\n]){0,60}?(?:(?<!not )(?<!n['\u2019]t )missing|unavailable|not found|(?:not|isn['\u2019]t) (?:installed|available))|^(?:(?!codex|cursor|agy|[.;]\\s)[^\\n])*?(?:(?<!not )(?<!n['\u2019]t )missing|unavailable|not found|(?:not|isn['\u2019]t) (?:installed|available))(?:(?!codex|cursor|agy|[.;]\\s)[^\\n]){0,40}?claude"
    }
  ],
  "max_turns": 20,
  "timeout_seconds": 300,
  "calendar": "calendar.json",
  "runtimes_present": [
    "codex"
  ]
}
