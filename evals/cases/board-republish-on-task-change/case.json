{
  "golden": true,
  "golden_why": "board: the board stops tracking the tracker",
  "tz": "America/Chicago",
  "description": "task-done-ticks-checkbox with a board at a known URL and a stale html on disk: after the tracker edits, the page server renders the board from the tracker at the same URL. No render step, never hand-edited html.",
  "prompt": "The audit is done.",
  "graders": [
    {
      "name": "task marked done",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|\\s*Security audit\\s*\\|[^\\n]*\\|\\s*done\\b"
    },
    {
      "name": "checkbox ticked",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[[xX]\\] Security audit of the upload endpoint"
    },
    {
      "name": "other checkbox untouched",
      "type": "file_matches",
      "path": "daily/{{today}}.md",
      "pattern": "(?m)^- \\[ \\] Draft release notes"
    },
    {
      "name": "other task untouched",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\| Draft release notes \\| Draft release notes \\| Robin \\| open \\| 09:00 \\|  \\| S \\| build \\| implement \\|  \\| Checklist: Draft release notes \\|$"
    },
    {
      "name": "log append-only, one line added",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "no render step: the server renders",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "render_board|decision_page|chief[-_]of[-_]stuff(?:\\.py)? (?:board|decision)\\b",
      "max": 0
    },
    {
      "name": "no Write/Edit to the board html",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "-board\\.html",
      "max": 0
    },
    {
      "name": "board republished showing the audit done",
      "type": "board_published",
      "min": 1,
      "tasks": [
        "Draft release notes"
      ],
      "html_match": "<figure class=\"columns\" aria-label=\"3 columns, 1 card\">[\\s\\S]*?<div class=\"columns-card-name\">Draft release notes</div>[\\s\\S]*?<section class=\"columns-col\" aria-label=\"review, 0\">"
    },
    {
      "name": "board matches the final tracker",
      "type": "board_matches_tracker",
      "tracker": "daily/{{today}}-tracker.md",
      "html": "pages/{{today}}-board.html"
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 300
}
