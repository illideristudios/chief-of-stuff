{
  "tz": "America/Chicago",
  "max_turns": 12,
  "description": "After the proposal, Robin says yes. The coordinator records the yes in Decisions, launches the dispatch in the background, marks the task running with the time, and keeps the Log append-only.",
  "timeout_seconds": 600,
  "turns": [
    {
      "prompt": "Start the audit.",
      "graders": [
        {
          "name": "no launch before a yes",
          "type": "tool_used",
          "tool": "Agent|Task",
          "max": 0
        }
      ]
    },
    {
      "prompt": "Yes.",
      "graders": [
        {
          "name": "reads the dispatch skill before the first launch, worktree, models call or tracker write",
          "rule": "Keep the existing Tasks item and name cells byte-for-byte: dispatch changes ownership and state, not the task's wording.",
          "type": "tool_used",
          "tool": "Read",
          "input_match": "\"file_path\": \"[^\"\\n]*skills/dispatch/SKILL\\.md\"",
          "min": 1,
          "before": "\\A(?=[\\s\\S]*\"(?:old_string|content)\":)[\\s\\S]*\"file_path\": \"(?:[^\"\\n]*[/\\\\])?daily[/\\\\][^\"\\n/\\\\]*-tracker\\.md\"|\"command\": \"(?:\\\\.|[^\"\\\\])*(?:\\bchief[-_]of[-_]stuff(?:\\.py)?\\s+(?:worker|worktree|models)\\b|(?:scripts/)?(?:spawn_session|make_worktree)\\.py\\b)|\"run_in_background\": true"
        },
        {
          "name": "launches in background",
          "type": "tool_used",
          "tool": "Agent|Task",
          "input_match": "\\\"run_in_background\\\": true",
          "min": 1
        },
        {
          "name": "task running HH:MM",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?m)^\\|\\s*Security audit[^|]*\\|[^\\n]*\\|\\s*running \\d{1,2}:\\d{2}\\s*\\|"
        },
        {
          "name": "yes recorded in Decisions",
          "type": "file_matches",
          "path": "daily/{{today}}-tracker.md",
          "pattern": "(?mi)^\\|[^\\n]*\\|\\s*[^\\n|]*Security audit[^\\n|]*\\|[^\\n|]*\\byes\\b[^\\n|]*\\|"
        },
        {
          "name": "log append-only",
          "type": "lines_preserved",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log",
          "min_added": 1
        },
        {
          "name": "Log times are this move's clock reads",
          "type": "timestamp_tolerance",
          "path": "daily/{{today}}-tracker.md",
          "section": "## Log"
        }
      ]
    }
  ],
  "superseded_by": "autonomy-interactive-dispatch"
}
