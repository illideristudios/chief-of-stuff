{
  "tz": "America/Chicago",
  "repo": {
    "clone": "repo",
    "trees": "trees",
    "worktrees": [],
    "files": {
      "src/a/upload.py": "def upload(request):\n    path = request.get('path')\n    return open(path, 'wb')\n",
      "src/a/__init__.py": "",
      "notes/.keep": ""
    }
  },
  "description": "With Agent: lines in the block, a dispatch proposal names a listed type, the one task it owns, and the branch and path the yes would create.",
  "prompt": "Start the security audit.",
  "graders": [
    {
      "name": "reads the dispatch skill before the first launch, worktree, models call or tracker write",
      "rule": "With `Agent:` lines: a session of one type named there — its own terminal, its own worktree — and then the proposal also names the branch and the path you would create, and the session's name.",
      "type": "tool_used",
      "tool": "Read",
      "input_match": "\"file_path\": \"[^\"\\n]*skills/dispatch/SKILL\\.md\"",
      "min": 1,
      "before": "\\A(?=[\\s\\S]*\"(?:old_string|content)\":)[\\s\\S]*\"file_path\": \"(?:[^\"\\n]*[/\\\\])?daily[/\\\\][^\"\\n/\\\\]*-tracker\\.md\"|\"command\": \"(?:\\\\.|[^\"\\\\])*(?:\\bchief[-_]of[-_]stuff(?:\\.py)?\\s+(?:worker|worktree|models)\\b|(?:scripts/)?(?:spawn_session|make_worktree)\\.py\\b)"
    },
    {
      "name": "no worktree cut before a yes",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:make_worktree\\.py|chief[-_]of[-_]stuff(?:\\.py)?\\s+worktree)[^\"]*--branch",
      "max": 0
    },
    {
      "name": "no session started before a yes",
      "type": "spawn_calls",
      "max": 0
    },
    {
      "name": "names a listed agent type",
      "type": "regex",
      "pattern": "(?i)\\b(implementer|fixer)\\b",
      "match": "contains"
    },
    {
      "name": "the prompt owns exactly one task",
      "type": "regex",
      "pattern": "(?s)```(?:(?!```).)*Task: *[^\\n]*Security audit(?:(?!```).)*```",
      "match": "contains"
    },
    {
      "name": "the prompt does not name the other task",
      "type": "regex",
      "pattern": "(?s)```(?:(?!```).)*Draft release notes(?:(?!```).)*```",
      "match": "absent"
    },
    {
      "name": "the ask names the branch it would create",
      "type": "regex",
      "pattern": "(?i)branch",
      "match": "contains"
    },
    {
      "name": "the ask names the tree it would create",
      "type": "regex",
      "pattern": "(?i)(worktree|trees/|\\btree\\b)",
      "match": "contains"
    },
    {
      "name": "no new files",
      "type": "no_new_files",
      "except": [
        "daily/{{today}}.md",
        "daily/{{today}}-tracker.md",
        "pages/{{today}}-board.html"
      ]
    }
  ],
  "max_turns": 14,
  "timeout_seconds": 400,
  "superseded_by": "autonomy-interactive-dispatch"
}
