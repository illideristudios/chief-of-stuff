{
  "tz": "America/Chicago",
  "peers": "sessions.json",
  "description": "Asked to brief a session, the coordinator sends one message whose first line is the whole ask, with context as file paths, and records it. No dispatch proposal, no pasted file contents, nothing about its own limits.",
  "prompt": "Brief 7719-notes on the audit task so it can pick it up if Robin says so.",
  "graders": [
    {
      "name": "reads the coordinator-sessions skill before the first session action",
      "rule": "A brief is context, not an instruction to start: use it when the user asks you to bring a session up to speed.",
      "type": "tool_used",
      "tool": "Read",
      "input_match": "\"file_path\": \"[^\"\\n]*skills/coordinator-sessions/SKILL\\.md\"",
      "min": 1,
      "before": "\\A(?=[\\s\\S]*\"(?:to|recipient)\": \"[^\"\\n]+\")[\\s\\S]*\"(?:text|content)\": \"|\"command\": \"(?:\\\\.|[^\"\\\\])*(?:\\bchief[-_]of[-_]stuff(?:\\.py)?\\s+inbox\\b|(?:scripts/)?inbox\\.py\\b)(?:(?![;&|]|\\\\n)(?:\\\\.|[^\"\\\\]))*\\bsend\\b|\"(?:session_id|session_ref|session)\": \"[^\"\\n]+\""
    },
    {
      "name": "one send to the briefed session",
      "type": "peer_calls",
      "tool": "send",
      "to_ref": "d4e5f6",
      "ok": true,
      "min": 1,
      "max": 1
    },
    {
      "name": "context as paths",
      "type": "peer_calls",
      "tool": "send",
      "to_ref": "d4e5f6",
      "text_match": "daily/\\{\\{today\\}\\}-tracker\\.md|daily/[0-9]{4}-[0-9]{2}-[0-9]{2}-tracker\\.md",
      "min": 1
    },
    {
      "name": "no pasted tracker contents",
      "type": "peer_calls",
      "tool": "send",
      "to_ref": "d4e5f6",
      "text_not_match": "\\| ref \\| name \\|",
      "min": 1
    },
    {
      "name": "no coordinator limits relayed",
      "type": "peer_calls",
      "tool": "send",
      "to_ref": "d4e5f6",
      "text_not_match": "(?i)human-only|i can('|no)t|write only",
      "min": 1
    },
    {
      "name": "no dispatch proposal",
      "type": "regex",
      "pattern": "(?s)```[^`]*\\bTask:[^`]*\\bReport:",
      "match": "absent"
    },
    {
      "name": "logged",
      "type": "lines_preserved",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log",
      "min_added": 1
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 16,
  "timeout_seconds": 400
}
