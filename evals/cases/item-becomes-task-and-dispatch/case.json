{
  "tz": "America/Chicago",
  "description": "A task-shaped instruction (\"make sure X\") becomes a Tasks row and a dispatch proposal. The coordinator does not inspect the tree itself.",
  "prompt": "Make sure the .gitignore is reasonable.",
  "graders": [
    {
      "name": "reads the dispatch skill before the first launch, worktree, models call or tracker write",
      "rule": "The Tasks item is the whole ask — write it so a session that reads only that row knows what it is for and what finished looks like, because that is the text the session receives.",
      "type": "tool_used",
      "tool": "Read",
      "input_match": "\"file_path\": \"[^\"\\n]*skills/dispatch/SKILL\\.md\"",
      "min": 1,
      "before": "\\A(?=[\\s\\S]*\"(?:old_string|content)\":)[\\s\\S]*\"file_path\": \"(?:[^\"\\n]*[/\\\\])?daily[/\\\\][^\"\\n/\\\\]*-tracker\\.md\"|\"command\": \"(?:\\\\.|[^\"\\\\])*(?:\\bchief[-_]of[-_]stuff(?:\\.py)?\\s+(?:worker|worktree|models)\\b|(?:scripts/)?(?:spawn_session|make_worktree)\\.py\\b)"
    },
    {
      "name": "task recorded",
      "type": "file_matches",
      "path": "daily/{{today}}-tracker.md",
      "pattern": "(?m)^\\|[^\\n]*gitignore"
    },
    {
      "name": "never opens or greps the .gitignore or the tree",
      "type": "tool_used",
      "tool": "Read|Grep|Glob|Bash",
      "input_match": "\\.gitignore|\\bcat\\b|\\bfind\\b|git status|git ls-files|src/|dist/",
      "max": 0
    },
    {
      "name": "dispatch proposal present",
      "type": "regex",
      "pattern": "```"
    },
    {
      "name": "not launched",
      "type": "tool_used",
      "tool": "Agent|Task",
      "max": 0
    },
    {
      "name": "no Write/Edit outside today's log and tracker",
      "type": "tool_used",
      "tool": "Write|Edit",
      "input_match": "\"file_path\": \"(?![^\"]*/daily/{{today}}(?:-tracker)?\\.md\")",
      "max": 0
    },
    {
      "name": "no git attempt",
      "type": "git_write",
      "subcommands": [
        "commit",
        "add",
        "push",
        "merge"
      ]
    },
    {
      "name": "Log times are this move's clock reads",
      "type": "timestamp_tolerance",
      "path": "daily/{{today}}-tracker.md",
      "section": "## Log"
    }
  ],
  "max_turns": 12,
  "timeout_seconds": 300
}
